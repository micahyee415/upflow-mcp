# Upflow API credentials — get from Upflow dashboard
# Store actual values in GCP Secret Manager (never commit)
UPFLOW_API_KEY=your_api_key_here
UPFLOW_API_SECRET=your_api_secret_here

# Optional: set to "true" to use the Upflow sandbox environment
UPFLOW_SANDBOX=false

# Port for local development (Cloud Run injects PORT automatically)
PORT=8080
